{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/agent_env.sh *)",
      "Edit(./.work/board/docs/agents/**)",
      "Write(./.work/board/docs/agents/**)"
    ],
    "deny": [
      "Bash(git clone *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * *:main)",
      "Bash(git push * +*)",
      "Bash(git push * main *)",
      "Bash(git push * HEAD:main *)",
      "Bash(git push * *:main *)",
      "Bash(git push main *)",
      "Bash(git push * refs/heads/main*)",
      "mcp__*__add_repo",
      "mcp__*__create_session",
      "mcp__*__create_trigger",
      "mcp__*__update_trigger",
      "mcp__*__delete_trigger",
      "mcp__*__fire_trigger",
      "mcp__*__send_later",
      "mcp__*__archive_session",
      "mcp__*__create_file",
      "mcp__*__update_file",
      "mcp__*__copy_file",
      "mcp__*__share_file",
      "mcp__*__trash_file",
      "Bash(git * --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git * core.hooksPath*)",
      "Bash(*AGENT_ENV_INTERNAL_PUSH*)",
      "mcp__*__push_files",
      "mcp__*__create_or_update_file",
      "mcp__*__delete_file",
      "mcp__*__merge_pull_request",
      "mcp__*__create_branch",
      "mcp__*__update_pull_request_branch"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "AGENT_ENV_SETUP_BY=hook bash \"$CLAUDE_PROJECT_DIR/scripts/agent_env.sh\" setup",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
