{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bash scripts/agent_env.sh *)"
    ],
    "deny": [
      "Bash(git clone *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push --mirror *)",
      "Bash(git push --delete *)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(git push * *:main)",
      "Bash(git push * +*)",
      "mcp__*__add_repo",
      "mcp__*__create_session",
      "mcp__*__create_trigger",
      "mcp__*__update_trigger",
      "mcp__*__delete_trigger",
      "mcp__*__fire_trigger",
      "mcp__*__send_later",
      "mcp__*__archive_session",
      "mcp__*__create_file",
      "mcp__*__update_file",
      "mcp__*__copy_file",
      "mcp__*__share_file",
      "mcp__*__trash_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/agent_env.sh\" setup",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
