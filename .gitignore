# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Secrets — never commit these
.env
*.key
*-service-account.json
firebase-credentials.json
serviceAccountKey.json

# Client data — drawings, takeoffs, contracts stay out of git
/data/*
# ...except the trade rule library: that is Urban Projects' own policy about
# what each trade does to a room, not a client document, and the engine cannot
# run without it. Space maps stay out — they carry a client's room dimensions.
!/data/trade_rules/
# ...and the canonical registries: trade ids and space-label aliases are Urban
# Projects vocabulary, not client documents, and the schema validates against them.
!/data/registry/
*.dwg
*.dxf
# T-470 (owner 2026-11-02, PRIVACY_MOVE_PLAN step 3): AutoCAD drawings and their side files in any letter case
# (git matches case-sensitively, so *.dxf missed DRAWING.DXF), plus extensionless files named DXF / DWG at any depth
# (the tracked root file `DXF` stays tracked: ignore rules never untrack; its move waits for the owner).
# A drawing with any other extensionless name cannot be caught by a name rule: tests/t470_drawing_guard checks every
# tracked file's content (DWG 'AC10' header, ASCII / binary DXF signature) instead.
*.[dD][wW][gG]
*.[dD][xX][fF]
*.[dD][wW][fF]
*.[dD][wW][lL]
*.[dD][wW][lL]2
*.[bB][aA][kK]
*.[sS][vV]$
[dD][xX][fF]
[dD][wW][gG]
# ...a DIRECTORY named dxf / dwg (code packages) is not a drawing: re-include it
![dD][xX][fF]/
![dD][wW][gG]/
*.xlsx
!tests/**/*.xlsx

# OS
.DS_Store
.secrets/

# S1 human-review drawings embed client drawing content (xlsx already ignored above)
research/alsenan_structural_census_s1/review/*.pdf
research/alsenan_column_rebar_s3/review/*.pdf
# S9A visual QA PDF: printed from the frozen HTML, embeds client plan geometry (like the review PDFs)
research/alsenan_structural_s9a/visual/*.pdf
# M1 BOQ: the PDF is printed from the frozen HTML; the run log holds machine timings (not frozen)
research/alsenan_m1_usable_boq/boq/*.pdf
research/alsenan_m1_usable_boq/boq/run_log.json

# M2 generated PDFs / workbooks stay out of git (reproducible by command)
research/urban_engine_m2_generalization/**/*.pdf
# M3: OCR crops and page renders are client drawing content (the evidence JSON keeps their file names only)
research/urban_engine_m3_recovery/**/crops/
research/urban_engine_m3_recovery/**/*.png
research/urban_engine_m3_recovery/**/*.pdf
# M4: generated workbooks / PDFs, the machine run log, review sheets with crops (client drawing content)
research/urban_engine_m4_correctness/**/*.pdf
research/urban_engine_m4_correctness/**/*.png
research/urban_engine_m4_correctness/**/crops/
research/urban_engine_m4_correctness/**/run_log.json
research/urban_engine_m4_correctness/.m3_snapshot.json
# M5: generated PDF / images (client drawing geometry); the workbooks are covered by *.xlsx
research/urban_engine_m5_concrete_reconciliation/**/*.pdf
research/urban_engine_m5_concrete_reconciliation/**/*.png
# M7: the visual QA PDF is generated from the committed records (build_visuals.py); the workbook is covered by *.xlsx
research/urban_engine_m7_reliability/**/*.pdf
