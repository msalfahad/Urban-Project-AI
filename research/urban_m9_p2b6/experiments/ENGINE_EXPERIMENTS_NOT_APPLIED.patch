+                    w, h = math.dist(a, b) * unit_m, math.dist(b, c) * unit_m
+                    if COLUMN_SIDE_M[0] <= w <= COLUMN_SIDE_M[1] and COLUMN_SIDE_M[0] <= h <= COLUMN_SIDE_M[1]:
+                        seen.add(ids)
