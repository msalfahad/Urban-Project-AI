+    sgn = 0
+    for i in range(len(poly)):
+        (x0, y0), (x1, y1) = poly[i], poly[(i + 1) % len(poly)]
+        L = math.hypot(x1 - x0, y1 - y0)
+        c = ((x1 - x0) * (p[1] - y0) - (y1 - y0) * (p[0] - x0)) / L if L else 0.0
+        if abs(c) <= tol:
+            continue
+        if sgn == 0:
+            sgn = 1 if c > 0 else -1
+        elif (c > 0) != (sgn > 0):
+            return False
+    return True
