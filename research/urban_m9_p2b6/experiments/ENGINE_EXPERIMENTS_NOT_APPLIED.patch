+def _exp_jamb_span(o, door_segs, unit_m, tol_m=0.01):
+    """EXPERIMENT A: the span between the door symbol's own jamb lines inside the band opening, or None. A jamb line is
+    a door-layer segment across the band at full thickness (within tol), perpendicular to the wall within 2 degrees,
+    its middle between the gap's ends."""
+    (ux, uy), (nx, ny) = o["u"], o["n"]
+    tol = tol_m / unit_m
+    lo_o, hi_o = sorted((o["o0"], o["o1"]))
+    pos = []
+    for s in door_segs:
+        (ax, ay), (bx, by) = s["a"], s["b"]
+        L = math.hypot(bx - ax, by - ay)
+        if L <= 0 or abs(L - (hi_o - lo_o)) > tol:
+            continue
+        if abs(((bx - ax) * ux + (by - ay) * uy) / L) > math.sin(math.radians(2.0)):
+            continue
+        ta, tb = sorted((ax * nx + ay * ny, bx * nx + by * ny))
+        if abs(ta - lo_o) > tol or abs(tb - hi_o) > tol:
+            continue
+        sm = ((ax + bx) * ux + (ay + by) * uy) / 2
+        if o["s0"] - tol <= sm <= o["s1"] + tol:
+            pos.append(sm)
+    if len(pos) < 2:
+        return None
+    lo, hi = min(pos), max(pos)
+    if (o["s1"] - o["s0"]) - (hi - lo) <= 0.05 / unit_m:
+        return None
+    return lo, hi
+
