+def _exp_loose_rects(segs, unit_m, tol_m=0.002):
+    """EXPERIMENT C: closed rectangles of any orientation formed by four segments (one polyline or four LINEs) whose
+    ends meet within tol and whose corners are right angles within 1 degree; sides within COLUMN_SIDE_M ->
+    [{"corners", "w_m", "h_m", "ids"}]."""
+    tol = tol_m / unit_m
+    key = lambda p: (round(p[0] / tol), round(p[1] / tol))          # noqa: E731
+    at = defaultdict(list)
+    for s in segs:
