+def _exp_face_is_wall(o, off, x0, x1, wall_segs, unit_m, tol_m=0.01):
+    """EXPERIMENT A: is this stretch of one band face wall? Every part of it is drawn by a wall-layer segment lying on
+    the face, or is the mouth of a wall junction: two wall-layer segments perpendicular to the band, each ending on
+    the face at one end of the gap and leaving it away from the band."""
+    (ux, uy), (nx, ny) = o["u"], o["n"]
+    tol = tol_m / unit_m
+    mid_o = (o["o0"] + o["o1"]) / 2
+    cover, ends = [], []
+    for s in wall_segs:
+        (ax, ay), (bx, by) = s["a"], s["b"]
+        L = math.hypot(bx - ax, by - ay)
+        if L <= 0:
+            continue
+        sa, sb = ax * ux + ay * uy, bx * ux + by * uy
+        ta, tb = ax * nx + ay * ny, bx * nx + by * ny
+        if abs(ta - off) <= tol and abs(tb - off) <= tol:                     # on this face
+            lo, hi = sorted((sa, sb))
+            if hi > x0 + tol and lo < x1 - tol:
+                cover.append((max(lo, x0), min(hi, x1)))
+        elif abs(((bx - ax) * ux + (by - ay) * uy) / L) < math.sin(math.radians(2.0)):   # across the face
+            for (s_, t_), (t_other) in (((sa, ta), tb), ((sb, tb), ta)):
+                if abs(t_ - off) <= tol and (t_other - off) * (off - mid_o) > 0:      # ends here, leaves the band
+                    ends.append(s_)
+    cover.sort()
+    gaps, cur = [], x0
+    for lo, hi in cover:
+        if lo > cur + tol:
+            gaps.append((cur, lo))
+        cur = max(cur, hi)
+    if x1 > cur + tol:
+        gaps.append((cur, x1))
+    for g0, g1 in gaps:
+        if not (any(abs(e - g0) <= tol for e in ends) and any(abs(e - g1) <= tol for e in ends)):
+            return False
+    return True
+
