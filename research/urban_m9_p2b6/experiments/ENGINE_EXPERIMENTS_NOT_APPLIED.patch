+def _exp_cycle_points(arr, cyc, sag):
+    """EXPERIMENT B: the cycle's vertices with every arc edge flattened (chord sagitta <= sag)."""
+    pts = []
+    for ei, fw in cyc:
+        e = arr.edges[ei]
+        start = arr.nodes[e["n0"]] if fw else arr.nodes[e["n1"]]
+        pts.append(start)
+        if e["kind"] == "A":
+            pr = e["prim"]
+            sw = e["t1"] - e["t0"]
+            step = 2 * math.acos(max(-1.0, min(1.0, 1 - sag / pr.r))) if pr.r > sag else sw
+            k = max(1, math.ceil(abs(sw) / max(step, 1e-9)))
+            ts = [e["t0"] + sw * i / k for i in range(1, k)]
+            mids = [pr.point(x) for x in ts]
+            # the nodes are the arc's end points: order the inner points from this edge's start
+            if math.dist(mids[0], start) > math.dist(mids[-1], start) if mids else False:
+                mids.reverse()
+            pts += mids
+    return pts
+
