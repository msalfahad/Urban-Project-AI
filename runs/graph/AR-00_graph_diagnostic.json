        "gate_id": "G1-LENGTH",
        "note": "",
        "observed": "0.2 mm (epsilon 1.0 mm, absolute)",
        "question": "Is unexplained wall-length drift within numerical epsilon?",
        "status": "PASS",
        "threshold": "abs(drift) <= 1.0 mm (ABSOLUTE, never a percentage), with duplicate removal itemised",
        "why": "A face walk sums edges. Length that vanished without a reason is geometry the walk will not find, and a percentage tolerance would hide exactly the loss that matters."
      },
      {
        "gate_id": "G2-CLUSTERS",
        "note": "",
        "observed": 0,
        "question": "Is every over-spread cluster resolved or explicitly refused?",
        "status": "PASS",
        "threshold": "rejected_clusters == 0, or every one named in the exceptions",
        "why": "An unresolved node is a place where the walk does not know which edges meet. It will either skip a turn or invent one."
      },
      {
        "gate_id": "G3-TERMINI",
        "note": "",
        "observed": "109 of 228 termini unresolved",
        "question": "Is every terminus classified?",
        "status": "FAIL",
        "threshold": "UNRESOLVED termini == 0",
        "why": "An unclassified wall end is an open face boundary of unknown cause. The walk cannot tell a doorway from a missing wall, and one closes a room while the other leaves it open."
      },
      {
        "gate_id": "G4-CONCENTRATION",
        "note": "diagnostic only \u2014 does not gate, and a low value is not a failure",
        "observed": "57.9% of wall length in 7 major components",
        "question": "Where is the wall length concentrated?",
        "status": "DIAGNOSTIC_ONLY",
        "threshold": "DIAGNOSTIC ONLY \u2014 reported, never gating",
        "why": "80% was a number I chose, not one the building justifies. Length concentration does not decide whether a face can be walked: a component holding 90% of the metres and no cycle bounds nothing, and one holding 3% around a shaft bounds a real room. The question that matters is G8's. This stays visible as a diagnostic so a regression is noticeable, and it does not gate."
      },
      {
        "gate_id": "G5-EXPLAINED-DISCONNECTS",
        "note": "",
        "observed": "23 components with no explanation",
        "question": "Is every disconnect either valid or explicitly unresolved?",
        "status": "FAIL",
        "threshold": "components with cause J_UNRESOLVED == 0",
        "why": "An unexplained disconnect is an unknown: it may be a real separate structure or a wall the extractor lost. The walk gives a different answer for each and cannot tell which it is looking at."
      },
      {
        "gate_id": "G6-JUNCTIONS",
        "note": "",
        "observed": "0 unresolved junctions, 4 corner overlaps, 1 true crossings",
        "question": "Is there any systematic junction failure?",
        "status": "PASS",
        "threshold": "UNRESOLVED_JUNCTION == 0 and CORNER_OVERLAP correctly separated from TRUE_CROSS_JUNCTION",
        "why": "Degree decides how many half-edges leave a node. A corner read as a crossing gives the walk four exits where there are two, and false half-edges make false rooms."
      },
      {
        "gate_id": "G7-FRAGMENTATION",
        "note": "",
        "observed": "993 of 55144 short marks share a path with a long run",
        "question": "Is source-path fragmentation understood?",
        "status": "PASS",
        "threshold": "measured and reported, whatever the answer",
        "why": "If flattening broke architectural paths, the fragments must be reassembled before pairing; if it did not, reassembly would join unrelated geometry. The walk depends on which is true."
      },
      {
        "gate_id": "G8-CYCLES-IN-REAL-ROOMS",
        "note": "NECESSARY_CONDITION_ONLY",
        "observed": "14 of 17 regions could be enclosed; 43 independent cycles in 12 components",
        "question": "Do closed cycles exist where the raster says rooms are?",
        "status": "FAIL",
        "threshold": "every IN_SCOPE mapped region has at least one possibly-enclosing cycle (a NECESSARY condition; failure is conclusive, passing is not proof)",
        "why": "This is the only gate that checks the graph against the building rather than against itself. A graph can satisfy every other gate and still describe no rooms. It is the most meaningful gate here and it now carries the weight G4 was wrongly given."
      }
